---
// The glossary: each term has an id to link to, and the whole set is given to search engines
// as a DefinedTermSet.
import { definedTermSet } from '@eurth/style/build';
import Page from '@eurth/style/components/Page.astro';
import { site } from '../../eurth.config.mjs';
import { GLOSSARY_UPDATED, glossary, term } from '../content/glossary';

const terms = glossary.map(({ id, term, definition }) => ({ id, term, definition }));
const updated = new Date(`${GLOSSARY_UPDATED}T12:00:00Z`).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
---

<Page
  site={site}
  title="Glossary of banknote terms"
  description="The words of banknotes, explained in a sentence or two each: guilloche, intaglio, microprint, watermark, vignette, specimen and forty more, for worldbuilders."
  crumbs={[{ name: 'Glossary', path: '/glossary/' }]}
  jsonld={[definedTermSet(site, { name: 'Glossary of banknote terms', path: '/glossary/', terms })]}
>
  <article class="eu-prose">
    <p class="eu-kicker">Glossary</p>
    <h1>Glossary of banknote terms</h1>
    <p class="eu-lead">
      The words of paper money, in a sentence or two each. The <a href="/guide/">guide</a> shows how they fit together on a note, and the{' '}
      <a href="/">designer</a> lets you use them. Terms marked "In the designer" are parts you can draw yourself.
    </p>
    <dl>
      {
        glossary.map((entry) => (
          <>
            <dt id={entry.id}>
              {entry.term}
              {entry.inBank && <span class="eu-chip">In the designer</span>}
            </dt>
            <dd>
              {entry.definition}
              {entry.see?.length ? (
                <span class="eu-muted">
                  {' '}
                  See also{' '}
                  {entry.see.map((id, i) => (
                    <>
                      {i > 0 && (i === entry.see!.length - 1 ? ' and ' : ', ')}
                      <a href={`#${id}`}>{term(id)!.term.toLowerCase()}</a>
                    </>
                  ))}
                  .
                </span>
              ) : null}
            </dd>
          </>
        ))
      }
    </dl>
    <p class="eu-muted">Last updated <time datetime={GLOSSARY_UPDATED}>{updated}</time>.</p>
  </article>
</Page>

<style>
  dt {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    margin-top: var(--space-5);
    font: var(--type-heading);
    scroll-margin-top: var(--space-8);
  }

  dd {
    margin: var(--space-1) 0 0;
  }
</style>
