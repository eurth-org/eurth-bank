---
// The designer, and under it what search engines and newcomers both want: what it is, how to use
// it, and answers to the usual questions (also given to search engines as structured data).
import { faqPage, webApplication } from '@eurth/style/build';
import Page from '@eurth/style/components/Page.astro';
import { site } from '../../eurth.config.mjs';
import Designer from '../ui/Designer.svelte';

const faq = [
  { q: 'Is Bank free?', a: 'Yes. There is no account and no paid tier. It is made by the Eurth worldbuilding community for anyone who needs money that does not exist.' },
  {
    q: 'Where is my design saved?',
    a: 'In its link. The link holds the whole series, so copying the link is saving it. You can also download the pictures, or save your nation as a profile file that the other Eurth tools can read. Nothing is kept in your browser or on a server.',
  },
  {
    q: 'Can I make a real currency?',
    a: 'No. Bank is for fiction only. It refuses every real currency code, takes no photographs, and every picture carries the fine print "fictional currency, bank.eurth.org". You are free to call your invented money what you like.',
  },
  {
    q: 'What is the SPECIMEN mark for?',
    a: 'It says the note is for show and not for spending, as real banks mark their own samples. It is on by default and you can switch it off for a cleaner picture; the fine print in the margin always stays.',
  },
  { q: 'Can I print my notes?', a: 'They are pictures for wikis, stories and games: SVG, PNG and WebP, each side or the whole series on a sheet. Bank makes no print-ready files and nothing that could pass for real money.' },
  { q: 'Does it work offline, and on a phone?', a: 'Yes to both. After the first visit the site keeps a copy of itself on your device and opens without a connection.' },
];
---

<Page
  site={site}
  jsonld={[
    webApplication(site, {
      featureList: ['Banknotes, front and back', 'A whole series from one design', 'Guilloche rosettes from six numbers', 'SVG, PNG and WebP downloads', 'Link that holds the design', 'Nation profile file'],
    }),
    faqPage(faq),
  ]}
>
  <div class="eu-stack">
    <header class="eu-stack intro">
      <p class="eu-kicker">Bank, by Eurth</p>
      <h1>Banknotes for a nation that doesn't exist</h1>
      <p class="eu-lead">Name the currency, choose the values, and Bank prints the whole series: portrait, rosettes, signatures and serial numbers. Free, in your browser, no account needed.</p>
    </header>

    <!-- client:load draws the designer as real HTML first, then wakes it up. -->
    <Designer client:load siteName={site.name} siteUrl={site.url} />

    <section class="eu-prose">
      <h2>How it works</h2>
      <ol>
        <li>Give your currency a name, a sign and a code of three letters, and say which bank issues it. Or press Random and edit what comes out.</li>
        <li>Pick the values of the series. Every value gets its own colours, and each note is a step larger than the last.</li>
        <li>Design one note: the layout, the border, the paper, the portrait and the rosette. The whole series follows.</li>
        <li>Copy the link, or download any side of any note, or the whole series on one sheet.</li>
      </ol>
      <p>
        New to banknotes? The <a href="/guide/">guide</a> explains what each part of a note is for, the <a href="/glossary/">glossary</a> has the words, and the{' '}
        <a href="/templates/">templates</a> give you twelve currencies to start from.
      </p>

      <h2>Questions</h2>
      <dl>
        {
          faq.map((item) => (
            <>
              <dt>{item.q}</dt>
              <dd>{item.a}</dd>
            </>
          ))
        }
      </dl>
    </section>
  </div>

  <Fragment slot="inspirations">Bank takes after the engravers and central bank designers whose work the guide describes, and after Flagwright and Governmint.</Fragment>
</Page>

<style>
  .intro {
    gap: var(--space-2);
  }

  dt {
    margin-top: var(--space-4);
    font: var(--type-heading);
  }

  dd {
    margin: var(--space-1) 0 0;
  }
</style>
